<com.android.launcher3.quickspace.views.OrbitGlanceView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quickspace_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/glance_orbit_dial"
            android:layout_width="116dp"
            android:layout_height="116dp">

            <com.android.launcher3.quickspace.views.OrbitRingView
                android:id="@+id/glance_orbit_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/glance_orbit_day_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@*android:string/config_headlineFontFamily"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:textSize="42sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/glance_orbit_short_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@*android:string/config_bodyFontFamily"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.2"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/glance_orbit_weather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/glance_orbit_weather_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="8dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/glance_orbit_temperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@*android:string/config_headlineFontFamily"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/glance_orbit_condition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:fontFamily="@*android:string/config_bodyFontFamily"
                    android:maxLines="1"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/glance_orbit_event"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/glance_orbit_event_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_quickspace_calendar" />

                <TextView
                    android:id="@+id/glance_orbit_event_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:fontFamily="@*android:string/config_bodyFontFamily"
                    android:maxLines="1"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/glance_orbit_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.android.launcher3.quickspace.views.EqualizerView
                    android:id="@+id/glance_orbit_equalizer"
                    android:layout_width="wrap_content"
                    android:layout_height="15dp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/glance_orbit_line_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp" />

                <TextView
                    android:id="@+id/glance_orbit_line_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:fontFamily="@*android:string/config_bodyFontFamily"
                    android:maxLines="1"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.android.launcher3.quickspace.views.OrbitGlanceView>
