<com.android.launcher3.quickspace.views.NeonGlanceView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quickspace_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingTop="4dp">

    <LinearLayout
        android:id="@+id/glance_neon_sign"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="28dp"
        android:layout_marginTop="26dp"
        android:layout_marginEnd="28dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="18dp">

        <com.android.launcher3.quickspace.views.NeonTextView
            android:id="@+id/glance_neon_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@*android:string/config_headlineFontFamily"
            android:includeFontPadding="false"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:textSize="50sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/glance_neon_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@*android:string/config_bodyFontFamily"
            android:includeFontPadding="false"
            android:letterSpacing="0.55"
            android:maxLines="1"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/glance_neon_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/glance_neon_weather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@*android:string/config_bodyFontFamily"
                android:letterSpacing="0.16"
                android:maxLines="1"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/glance_neon_dot"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/glance_neon_event"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@*android:string/config_bodyFontFamily"
                android:letterSpacing="0.16"
                android:maxLines="1"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/glance_neon_song_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/glance_neon_song_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_music_note_24dp" />

            <TextView
                android:id="@+id/glance_neon_song"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@*android:string/config_bodyFontFamily"
                android:letterSpacing="0.16"
                android:maxLines="1"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</com.android.launcher3.quickspace.views.NeonGlanceView>
