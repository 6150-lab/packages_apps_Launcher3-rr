<!-- Flatline Signature: the line running on from the time's last digit, the date under both. -->
<com.android.launcher3.quickspace.views.FlatlineGlanceView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:id="@+id/quickspace_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="10dp"
    android:paddingTop="4dp"
    android:paddingEnd="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:clipChildren="false"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/glance_flatline_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:letterSpacing="-0.04"
                android:singleLine="true"
                android:textSize="62dp" />

            <com.android.launcher3.quickspace.views.FlatlineTraceView
                android:id="@+id/glance_flatline_trace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                launcher:flatlineReadout="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/glance_flatline_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@*android:string/config_bodyFontFamily"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/glance_flatline_separator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@*android:string/config_bodyFontFamily"
                android:includeFontPadding="false"
                android:text="&#183;"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/glance_flatline_weather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/glance_flatline_weather_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="4dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/glance_flatline_temperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@*android:string/config_bodyFontFamily"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.android.launcher3.quickspace.views.FlatlineGlanceView>
