<com.android.launcher3.quickspace.views.GlassGlanceView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quickspace_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="4dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp">

    <LinearLayout
        android:id="@+id/glance_glass_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/glance_glass_greeting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@*android:string/config_bodyFontFamily"
                android:maxLines="1"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/glance_glass_weather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="11dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/glance_glass_weather_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="6dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/glance_glass_temperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@*android:string/config_bodyFontFamily"
                    android:maxLines="1"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/glance_glass_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:fontFamily="@*android:string/config_headlineFontFamily"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="27sp" />

        <LinearLayout
            android:id="@+id/glance_glass_tiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/glance_glass_tile_a"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="20dp">

                    <ImageView
                        android:id="@+id/glance_glass_tile_a_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center_vertical" />

                    <com.android.launcher3.quickspace.views.EqualizerView
                        android:id="@+id/glance_glass_tile_a_equalizer"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_gravity="center_vertical"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/glance_glass_tile_a_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="@*android:string/config_bodyFontFamily"
                    android:maxLines="1"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/glance_glass_tile_a_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@*android:string/config_bodyFontFamily"
                    android:maxLines="1"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/glance_glass_tile_a_level_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <View
                        android:id="@+id/glance_glass_tile_a_level"
                        android:layout_width="0dp"
                        android:layout_height="5dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/glance_glass_tile_a_level_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@*android:string/config_bodyFontFamily"
                        android:maxLines="1"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/glance_glass_tile_b"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="20dp">

                    <ImageView
                        android:id="@+id/glance_glass_tile_b_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center_vertical" />

                    <com.android.launcher3.quickspace.views.EqualizerView
                        android:id="@+id/glance_glass_tile_b_equalizer"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_gravity="center_vertical"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/glance_glass_tile_b_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="@*android:string/config_bodyFontFamily"
                    android:maxLines="1"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/glance_glass_tile_b_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@*android:string/config_bodyFontFamily"
                    android:maxLines="1"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/glance_glass_tile_b_level_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <View
                        android:id="@+id/glance_glass_tile_b_level"
                        android:layout_width="0dp"
                        android:layout_height="5dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/glance_glass_tile_b_level_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@*android:string/config_bodyFontFamily"
                        android:maxLines="1"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.android.launcher3.quickspace.views.GlassGlanceView>
