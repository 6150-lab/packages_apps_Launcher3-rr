    <!-- At a glance styles -->
    <string name="glance_content_description">At a glance</string>
    <string name="glance_battery_level"><xliff:g id="level" example="80">%1$d</xliff:g>%%</string>
    <!-- Flatline styles: the readout while nothing plays, the Vitals card's title and its alarm -->
    <string name="glance_flatline_idle" translatable="false">RESURRECTED REMIX</string>
    <string name="glance_flatline_vitals">Vitals</string>
    <string name="glance_flatline_alarm">Alarm <xliff:g id="time" example="6:30">%1$s</xliff:g></string>
