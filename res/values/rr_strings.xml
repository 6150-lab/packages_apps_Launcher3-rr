    <string-array name="glance_flatline_rest_entries">
        <item>Scan dot</item>
        <item>Resting pulse</item>
        <item>Always beating</item>
    </string-array>
    <string-array name="glance_flatline_rest_values" translatable="false">
        <item>0</item>
        <item>1</item>
        <item>2</item>
    </string-array>

    <!-- At a glance: live scores of the teams followed in the Google app -->
    <string name="quickspace_scores_title">Live scores</string>
    <string name="quickspace_scores_summary">Games of the teams you follow in the Google app</string>
