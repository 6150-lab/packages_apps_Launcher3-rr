<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.launcher3">

    <Preference
        android:key="pref_icon_pack"
        android:title="@string/icon_pack_title" />

    <SwitchPreference
        android:key="pref_themed_icons_overlay"
        android:title="@string/themed_icons_overlay_title"
        android:summary="@string/themed_icons_overlay_summary"
        android:defaultValue="true"
        android:persistent="true" />

    <ListPreference
        android:key="pref_icon_style_rr"
        android:title="@string/icon_style_rr_title"
        android:entries="@array/icon_style_rr_entries"
        android:entryValues="@array/icon_style_rr_values"
        android:summary="%s"
        android:persistent="false" />

    <PreferenceCategory
        android:key="pref_neon_category"
        android:title="@string/neon_icons_title">

        <ListPreference
            android:key="pref_neon_ring_color"
            android:title="@string/neon_ring_color_title"
            android:entries="@array/neon_ring_color_entries"
            android:entryValues="@array/neon_ring_color_values"
            android:summary="%s"
            android:defaultValue="accent"
            android:persistent="true" />

        <com.android.launcher3.settings.preferences.CustomSeekBarPreference
            android:key="pref_neon_glow"
            android:title="@string/neon_glow_title"
            android:persistent="true"
            android:max="100"
            settings:min="0"
            settings:units="%"
            android:defaultValue="60" />

        <ListPreference
            android:key="pref_neon_ring"
            android:title="@string/neon_ring_title"
            android:entries="@array/neon_ring_entries"
            android:entryValues="@array/neon_ring_values"
            android:summary="%s"
            android:defaultValue="1"
            android:persistent="true" />

        <SwitchPreference
            android:key="pref_neon_folders"
            android:title="@string/neon_folders_title"
            android:defaultValue="true"
            android:persistent="true" />
    </PreferenceCategory>

    <com.android.launcher3.settings.NotificationDotsPreference
        android:key="pref_icon_badging"
        android:title="@string/notification_dots_title"
        android:persistent="false"
        android:widgetLayout="@layout/notification_pref_warning" />

    <SwitchPreferenceCompat
        android:key="pref_notification_badge_count"
        android:title="@string/notification_badge_count_title"
        android:summary="@string/notification_badge_count_desc"
        android:persistent="true"
        android:defaultValue="false" />

    <com.android.launcher3.settings.preferences.CustomSeekBarPreference
        android:key="pref_custom_icon_size"
        android:title="@string/icon_size_title"
        android:persistent="true"
        android:max="150"
        settings:min="50"
        settings:units="%"
        android:defaultValue="100" />

    <com.android.launcher3.settings.preferences.CustomSeekBarPreference
        android:key="pref_custom_font_size"
        android:title="@string/font_size_title"
        android:persistent="true"
        android:max="150"
        settings:min="50"
        settings:units="%"
        android:defaultValue="100" />

</androidx.preference.PreferenceScreen>
